# SpendTrace Environment Variables
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
DEFAULT_MODEL=gemini-2.0-flash

# Optional: PostgreSQL Database (defaults to local SQLite spendtrace.db if unset)
# DATABASE_URL=postgresql://user:password@localhost:5432/spendtrace

# Supabase Auth Configuration (optional overrides)
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_JWT_SECRET=spendtrace-supabase-secret-key-32-chars-min!
